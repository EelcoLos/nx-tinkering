<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- A2A (.NET SDK is preview; implements the A2A v1.0 spec) -->
    <PackageVersion Include="A2A" Version="1.0.0-preview2" />
    <PackageVersion Include="A2A.AspNetCore" Version="1.0.0-preview2" />
    <!-- FastEndpoints -->
    <PackageVersion Include="FastEndpoints" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.A2A" Version="1.0.0-beta.5" />
    <PackageVersion Include="FastEndpoints.OpenApi" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.Security" Version="8.3.0" />
    <!-- Microsoft.AspNetCore -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- Microsoft.Identity -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Identity.Web.GraphServiceClient" Version="4.16.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <!-- Microsoft Graph: transitive pin (via Microsoft.Identity.Web.GraphServiceClient, which only requires Graph 5+) -->
    <PackageVersion Include="Microsoft.Graph" Version="6.8.0" />
    <!-- ponytail: kept below 3.0, Microsoft.AspNetCore.OpenApi 10.0.x declares Microsoft.OpenApi [2.12.0, 3.0.0) and its document generator doesn't work with the v3 library; revisit on net11 -->
    <PackageVersion Include="Microsoft.OpenApi" Version="[2.12.2,3.0.0)" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!-- Scalar -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.14" />
    <!-- Vogen -->
    <PackageVersion Include="Vogen" Version="8.0.7" />
    <!-- xunit -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>