# fastendpoints-react-api: FastEndpoints API with JWT bearer auth.
# Requires Jwt:SigningKey (32+ bytes) via user-secrets or the Jwt__SigningKey env var.
# HTTPS only: http://localhost:5003 redirects (307) to https://localhost:5002.
@host = https://localhost:5002

### Login (demo password: SecureDevPassword123!)
# @name login
POST {{host}}/api/login
Content-Type: application/json

{
  "email": "any@mail.com",
  "password": "SecureDevPassword123!"
}

###
@token = {{login.response.body.$.accessToken}}

### Validate token (protected)
GET {{host}}/api/validate-token
Authorization: Bearer {{token}}

### Validate token without auth (expect 401)
GET {{host}}/api/validate-token

### Login with a wrong password (expect 400)
POST {{host}}/api/login
Content-Type: application/json

{
  "email": "any@mail.com",
  "password": "wrong"
}

### OpenAPI document (Development only)
GET {{host}}/openapi/v1.json

### Scalar API reference (Development only)
GET {{host}}/scalar/v1
