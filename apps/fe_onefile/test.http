# fe_onefile: single-file FastEndpoints app (no auth, no OpenAPI).
# Start (from this folder): dotnet run FE_OneFile.cs
@host = http://localhost:5000

### Create user (anonymous)
POST {{host}}/api/user/create
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Doe",
  "age": 30
}
