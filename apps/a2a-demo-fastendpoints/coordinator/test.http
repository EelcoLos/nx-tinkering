# a2a-demo-fastendpoints coordinator (FastEndpoints.A2A 1.0.0-beta.5, A2A v1.0 JSON-RPC binding).
# Start (from this folder): dotnet run coordinator.cs
# Delegates to the specialist, which must be running on http://localhost:5162. There is no "/" route.
@host = http://localhost:5163

### Well-known agent card
GET {{host}}/.well-known/agent-card.json

### A2A JSON-RPC SendMessage to the coordinator_delegate skill (delegates to the specialist)
POST {{host}}/a2a
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "SendMessage",
  "params": {
    "message": {
      "messageId": "local-client-2",
      "role": "ROLE_USER",
      "parts": [
        { "data": { "Input": "delegate this" } }
      ]
    },
    "metadata": {
      "skill": "coordinator_delegate"
    }
  }
}

### Same skill as a plain FastEndpoints endpoint (anonymous)
POST {{host}}/skills/coordinator-delegate
Content-Type: application/json

{
  "input": "delegate this"
}
